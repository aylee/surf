# Optional non-interactive Cloudflare authentication. `wrangler login` is the
# simplest local path; CI can set these values as encrypted secrets instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# External mode-0600 activation snapshot for every operational Cloudflare
# read/write and `pnpm ops:status`. Only the local, secretless wrapper check
# `pnpm wrangler -- --version` may omit it. Create both values with
# `pnpm wrangler:snapshot`; enabled deploys require the exact SHA-256 and never
# accept a mutable source.
SURF_WRANGLER_CONFIG=
SURF_WRANGLER_CONFIG_SHA256=

# Used by the production smoke test and manual ingest helper.
SURF_BASE_URL=
SURF_INGEST_TOKEN=

# Enabled Analysis v5 validates explicit external mode-0600 files before a
# staged deploy. These variables contain paths only, never secret values. The
# Worker source contains exactly NARRATIVE_RESULT_TOKEN and GEMINI_API_KEY;
# deploy writes and then exclusively reuses the named private JSON activation
# snapshot. The versioned runner file contains the matching result token,
# Queue credential, target map, and local runtime settings.
SURF_WORKER_SECRETS_FILE=
SURF_WORKER_SECRETS_SNAPSHOT=
SURF_NARRATIVE_RUNNER_ENV_FILE=
