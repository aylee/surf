# Copy to apps/narrative-runner/.env and keep that ignored file mode 0600.
# Values ending in _TOKEN are secrets and intentionally have no example value.

NARRATIVE_RUNNER_ID=always-on-mac
NARRATIVE_RUNNER_RELEASE_SHA=replace-with-exact-40-character-merged-sha
# The production guard supplies the same SHA separately from its attested
# activation record. For a standalone package command, export
# NARRATIVE_EXPECTED_RELEASE_SHA explicitly;
# do not add a second self-attesting release value to this dotenv file.
# Separate high-entropy key used only to HMAC the effective runtime identity
# written to the secret-safe heartbeat. Rotate it with any credential change.
NARRATIVE_RUNNER_STATUS_HMAC_KEY=

# Cloudflare Queues HTTP pull consumer. The token needs account Queues Read and
# Write so the runner can both pull and acknowledge/retry leases.
NARRATIVE_RUNNER_CF_API_BASE_URL=https://api.cloudflare.com/client/v4
NARRATIVE_RUNNER_CF_ACCOUNT_ID=replace-with-account-id
NARRATIVE_RUNNER_CF_QUEUE_ID=replace-with-queue-id
NARRATIVE_RUNNER_CF_QUEUE_NAME=surf-narrative
NARRATIVE_RUNNER_CF_DLQ_NAME=surf-narrative-dlq
NARRATIVE_RUNNER_CF_API_TOKEN=

# Local oMLX OpenAI-compatible endpoint. Plain HTTP is accepted only for a
# loopback host. Leave the token empty when the loopback server has no API key.
NARRATIVE_RUNNER_OMLX_BASE_URL=http://127.0.0.1:8000/v1
NARRATIVE_RUNNER_OMLX_MODEL=replace-with-id-from-v1-models
NARRATIVE_RUNNER_OMLX_API_TOKEN=
# Structured report templates should not spend hidden reasoning tokens.
NARRATIVE_RUNNER_OMLX_ENABLE_THINKING=false

# Jobs contain only a logical result.target. This runtime map owns callback
# URLs and names the separate environment variable holding each bearer token.
# Never put a token or a job-provided URL in this JSON value.
NARRATIVE_RUNNER_TARGET_MAP_JSON={"surf.analysis.v5":{"url":"https://replace-with-surf-origin.example/api/internal/narratives/results","tokenEnv":"SURF_NARRATIVE_RESULT_TOKEN"}}
SURF_NARRATIVE_RESULT_TOKEN=

NARRATIVE_RUNNER_CONCURRENCY=1
NARRATIVE_RUNNER_VISIBILITY_TIMEOUT_MS=900000
NARRATIVE_RUNNER_QUEUE_TIMEOUT_MS=30000
NARRATIVE_RUNNER_POLL_INTERVAL_MS=5000
NARRATIVE_RUNNER_IDLE_MAX_MS=120000
NARRATIVE_RUNNER_HEARTBEAT_INTERVAL_MS=15000
NARRATIVE_RUNNER_PREFLIGHT_INTERVAL_MS=60000
NARRATIVE_RUNNER_MODEL_BACKOFF_MS=30000
NARRATIVE_RUNNER_OMLX_TIMEOUT_MS=600000
NARRATIVE_RUNNER_RESULT_TIMEOUT_MS=30000
NARRATIVE_RUNNER_RETRY_BASE_SECONDS=30
NARRATIVE_RUNNER_RETRY_MAX_SECONDS=3600
NARRATIVE_RUNNER_STATUS_FILE=/Users/alex/Services/surf/state/narrative-runner-status.json
