{
  "name": "@surf/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:local": "pnpm db:migrate:local && pnpm db:seed:local",
    "dev": "pnpm setup:local && pnpm dev:worker",
    "dev:ui": "vite --host 127.0.0.1 --port 5173",
    "dev:worker": "pnpm build && wrangler dev --local --port 8787",
    "build": "vite build",
    "check": "pnpm types:worker:check && tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "types:worker": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime=false --env-file .dev.vars.example",
    "types:worker:check": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime=false --env-file .dev.vars.example --check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --yes --file ../../packages/db/seeds/0000_v1_norcal.sql",
    "ingest:local": "node scripts/ingest-once.mjs --local",
    "ingest:remote": "node scripts/ingest-once.mjs --remote",
    "smoke:cloudflare": "node scripts/smoke-cloudflare.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.44",
    "@hono/zod-validator": "0.9.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@surf/contracts": "workspace:*",
    "@surf/forecast-core": "workspace:*",
    "@surf/narrative-contracts": "workspace:*",
    "agents": "0.21.0",
    "ai": "7.0.66",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.3",
    "lucide-react": "1.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260818.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.124.0"
  }
}
