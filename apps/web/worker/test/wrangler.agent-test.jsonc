{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "surf-forecast-brief-agent-test",
  "main": "../index.ts",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "test",
    "SURF_REGION": "norcal",
    "SURF_USER_AGENT": "surf-agent-test/1.0",
    // Dormant compatibility suite only. Supported instance configs must keep
    // this false and Analysis v3 never signals this Agent.
    "FORECAST_BRIEF_ENABLED": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FORECAST_BRIEF_AGENT",
        "class_name": "ForecastBriefAgent"
      }
    ]
  },
  "exports": {
    "ForecastBriefAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "surf-agent-test",
      "migrations_dir": "../../../../packages/db/migrations"
    }
  ]
}
